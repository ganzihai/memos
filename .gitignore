--- .gitignore (原始)
```
# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.*

# IDE files
.vscode/
.idea/

# Build artifacts
dist/
build/
target/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Logs
*.log

# Temporary files
*.tmp
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/
.coverage

# MyPy cache
.mypy_cache/

# Pytest cache
.pytest_cache/

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```

